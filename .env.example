# PostgreSQL database
DATABASE_URL=postgresql+asyncpg://salesmind:secret@localhost:5432/salesmind

# IBM Watsonx credentials
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Model configuration (override defaults if needed)
MODEL_FAST=ibm/granite-3-3-8b-instruct
MODEL_DEEP=ibm/granite-4.1-8b-instruct
MODEL_GUARDIAN=ibm/granite-guardian-3-8b

# Qualification thresholds
QUALIFICATION_THRESHOLD=60
CONFIDENCE_THRESHOLD=0.75

# API server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Optional: Tavily for enhanced web search
TAVILY_API_KEY=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# LangGraph persistence (optional: use sqlite for local, postgres for prod)
LANGGRAPH_CHECKPOINT_URI=sqlite:///checkpoints/pipeline.db
